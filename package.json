{
  "name": "lumni-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/pwa.mjs prepare && next dev --hostname 0.0.0.0",
    "build": "node scripts/pwa.mjs prepare && next build && node scripts/pwa.mjs build",
    "lint": "oxlint --deny-warnings src scripts tests playwright.config.ts",
    "format": "oxfmt src scripts tests playwright.config.ts",
    "format:check": "oxfmt --check src scripts tests playwright.config.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "preview": "node scripts/preview.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "14.9.0",
    "katex": "0.19.1",
    "next": "16.4.4",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.10.1"
}
